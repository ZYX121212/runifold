from typing import Any, Awaitable

__version__: str
__lock_sha256__: str

class NativeError(RuntimeError): ...

class ToolContext:
    @property
    def run_id(self) -> str: ...
    @property
    def invocation_id(self) -> str: ...
    @property
    def cancelled(self) -> bool: ...
    @property
    def remaining_seconds(self) -> float | None: ...

class Run:
    @property
    def run_id(self) -> str: ...
    @property
    def checkpoint_id(self) -> str | None: ...
    @property
    def finished(self) -> bool: ...
    def cancel(self) -> bool: ...
    def usage(self) -> str: ...
    def acknowledge_terminal(self) -> None: ...
    def next(self) -> Awaitable[str | None]: ...
    def wait_closed(self) -> Awaitable[None]: ...

class Runtime:
    def __init__(self, config: str) -> None: ...
    @staticmethod
    def scripted(config: str, scripts: str, delay_ms: int) -> Runtime: ...
    def start(self, config: str, input: str, options: str, dispatcher: Any) -> Run: ...
    def close(self) -> None: ...
    def wait_closed(self, timeout: float, callbacks: bool) -> Awaitable[None]: ...
    def snapshot(self) -> str: ...
    def recorded_requests(self) -> str: ...
