{
  "annotations": {
    "list": []
  },
  "description": "Runifold Agent, model, budget, and MCP Sampling operations.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "runifold:agent_runs:rate5m", "legendFormat": "Agent runs/s", "refId": "A"}],
      "title": "Agent Run Rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.99}]}, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "1 - runifold:agent_error_ratio:rate5m", "legendFormat": "Success ratio", "refId": "A"}],
      "title": "Agent Success SLI",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 30}]}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "runifold:agent_duration_seconds:p95_5m", "legendFormat": "P95", "refId": "A"}],
      "title": "Agent Duration P95",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.02}]}, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "runifold:agent_budget_exhaustion_ratio:rate15m", "legendFormat": "Budget exhaustion", "refId": "A"}],
      "title": "Budget Exhaustion Ratio",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 8},
      "id": 5,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(runifold_agent_operation_duration_seconds_bucket[5m])))", "legendFormat": "Agent P50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(runifold_agent_operation_duration_seconds_bucket[5m])))", "legendFormat": "Agent P95", "refId": "B"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket[5m])))", "legendFormat": "Model P95", "refId": "C"}
      ],
      "title": "Latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 8},
      "id": 6,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum(rate(runifold_agent_errors_total[5m])) by (error_type)", "legendFormat": "Errors: {{error_type}}", "refId": "A"},
        {"expr": "sum(rate(runifold_agent_budget_exhaustions_total[5m]))", "legendFormat": "Budget exhaustion", "refId": "B"}
      ],
      "title": "Agent Failure Rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 17},
      "id": 7,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum(rate(runifold_mcp_sampling_requests_total[5m]))", "legendFormat": "Requests/s", "refId": "A"},
        {"expr": "sum(rate(runifold_mcp_sampling_failures_total[5m]))", "legendFormat": "Failures/s", "refId": "B"},
        {"expr": "runifold:sampling_duration_seconds:p95_5m", "legendFormat": "Duration P95", "refId": "C"}
      ],
      "title": "MCP Sampling",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 17},
      "id": 8,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum(rate(runifold_agent_turns_count[5m]))", "legendFormat": "Completed runs with turn usage", "refId": "A"},
        {"expr": "sum(rate(runifold_agent_tool_calls_count[5m]))", "legendFormat": "Completed runs with Tool usage", "refId": "B"},
        {"expr": "sum(rate(runifold_agent_delegations_count[5m]))", "legendFormat": "Completed runs with delegation usage", "refId": "C"},
        {"expr": "sum(rate(runifold_agent_cost_sum[5m]))", "legendFormat": "Attributed USD/s", "refId": "D"}
      ],
      "title": "Agent Usage and Cost",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["runifold", "agent", "opentelemetry"],
  "templating": {
    "list": [
      {
        "current": {},
        "label": "Prometheus",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Runifold Operations",
  "uid": "runifold-operations",
  "version": 1
}
